# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-key

# SMTP Configuration (For Contact Form & Invites)
# Note: Auth emails are managed in Supabase Dashboard
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=true

# Razorpay Config
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Razorpay Subscription Plan IDs
# INR Plans
RAZORPAY_PLAN_INR_100=plan_inr_100_id
RAZORPAY_PLAN_INR_300=plan_inr_300_id
RAZORPAY_PLAN_INR_500=plan_inr_500_id
RAZORPAY_PLAN_INR_1000=plan_inr_100_id

# USD Plans
RAZORPAY_PLAN_USD_5=plan_usd_5_id
RAZORPAY_PLAN_USD_10=plan_usd_10_id
RAZORPAY_PLAN_USD_25=plan_usd_25_id
RAZORPAY_PLAN_USD_50=plan_usd_50_id

# EUR Plans
RAZORPAY_PLAN_EUR_5=plan_eur_5_id
RAZORPAY_PLAN_EUR_10=plan_eur_10_id
RAZORPAY_PLAN_EUR_25=plan_eur_25_id
RAZORPAY_PLAN_EUR_50=plan_eur_50_id

# GBP Plans
RAZORPAY_PLAN_GBP_5=plan_gbp_5_id
RAZORPAY_PLAN_GBP_10=plan_gbp_10_id
RAZORPAY_PLAN_GBP_25=plan_gbp_25_id
RAZORPAY_PLAN_GBP_50=plan_gbp_50_id